#!/bin/zsh
# auv3-test-ios: runs auv3-test's checks on an iPhone or iPad (or an iOS Simulator),
# against an AUv3 installed there, and prints the report here.
#
#   ./auv3-test-ios <device> <type> <subtype> <manufacturer> [options]
#   ./auv3-test-ios <device> --list
#   ./auv3-test-ios --devices
#
# <device> is a connected device's or a simulator's name (as `--devices` lists them) or
# its identifier. The options are the Mac command line's (`auv3-test --help`), except
# --window-size: the plugin's view fills the screen. --snapshot <png> saves a capture of
# the device's screen, with the plugin's view on it, here on the Mac.
#
# It builds the runner app (iOSRunner/AUv3TestRunner.xcodeproj), installs it, launches it
# with your arguments and waits for its report. The plugin's app must be installed on the
# device, and opened once so iOS registers its Audio Unit. A real device must be unlocked,
# and the runner signed by your team: set DEVELOPMENT_TEAM (e.g. in your shell profile),
# and AUV3_RUNNER_BUNDLE_ID to a bundle ID of your own, then do the README's one-time
# setup for devices.
#
# Exit status: 0 if every check passed, 1 if one failed, 2 if the plugin couldn't be
# tested, 3 if the runner couldn't be built, installed or launched.
set -uo pipefail
here=${0:A:h}
project="$here/iOSRunner/AUv3TestRunner.xcodeproj"
build="${AUV3_TEST_IOS_BUILD:-/tmp/auv3-test-ios-build}"
bundle="${AUV3_RUNNER_BUNDLE_ID:-io.github.sufystudios.auv3-test-runner}"

fail() { print -u2 "auv3-test-ios: $*"; exit 3; }

if [[ $# -eq 0 || "$1" == "--help" || "$1" == "-h" ]]; then
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
fi

if [[ "$1" == "--devices" ]]; then
    print "Connected iPhones and iPads:"
    xcrun devicectl list devices 2>/dev/null | awk 'NR > 2 && $0 ~ /physical/'
    print "\nSimulators:"
    xcrun simctl list devices available | grep -E '^\s+(iPhone|iPad)'
    exit 0
fi

device=$1
shift
[[ $# -gt 0 ]] || fail "say what to test: the plugin's codes (or --list) after the device"

# --snapshot <png> names a file on this Mac. The runner shows the plugin's view and says
# when it's ready (it's drawn by the plugin's own process, so only a capture of the
# screen shows it), and this captures the device's screen from here.
args=()
live=0
seconds=120
for (( i = 1; i <= $#; i++ )); do
    [[ "${@[i]}" == "--play" ]] && live=1
    [[ "${@[i]}" == "--seconds" ]] && seconds=${@[i+1]}
done
snapshot=""
audio_dir=""
spectrogram=""
while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--snapshot" && $# -gt 1 ]]; then
        snapshot=${2:A}
        args+=(--snapshot on-device.png)
        shift 2
    elif [[ "$1" == "--scenario" && $# -gt 1 ]]; then
        # The device can't read the Mac's files: pass the scenario itself.
        [[ -r "$2" ]] || fail "couldn't read the scenario file $2"
        args+=(--scenario-json "$(<"$2")")
        shift 2
    elif [[ "$1" == "--save-audio" && $# -gt 1 ]]; then
        # Files are written on the device, in the runner's own folder ("@out/"), and
        # copied back here afterwards (see fetch_output).
        audio_dir=${2:A}
        args+=(--save-audio @out/audio)
        shift 2
    elif [[ "$1" == "--spectrogram" && $# -gt 1 ]]; then
        spectrogram=${2:A}
        args+=(--spectrogram @out/spectrogram.png)
        shift 2
    else
        args+=("$1")
        shift
    fi
done
set -- "${args[@]}"

# Runs the launch command, printing nothing, and leaves its output in $output. With
# --snapshot, captures the screen (with the command in $capture, plus the file) once the
# runner says the plugin's view is ready.
launch() {
    local log=$(mktemp -t auv3-test-ios)
    "$@" >"$log" 2>&1 &
    local runner=$!
    if (( live )); then
        # Tell the person at the device when to start playing.
        while kill -0 $runner 2>/dev/null && ! grep -q "Playing .* live" "$log"; do sleep 0.3; done
        grep -q "Playing .* live" "$log" && print -u2 "▶︎ Play the plugin on $device now: its keys, its controls or a MIDI keyboard. It records for up to $seconds s."
    fi
    if [[ -n "$snapshot" ]]; then
        while kill -0 $runner 2>/dev/null && ! grep -q "=== auv3-test snapshot ready ===" "$log"; do sleep 0.5; done
        if grep -q "=== auv3-test snapshot ready ===" "$log"; then
            "${capture[@]}" "$snapshot" >/dev/null 2>&1 && print -u2 "… Saved the plugin's screen to $snapshot" \
                || print -u2 "auv3-test-ios: couldn't capture the screen for --snapshot"
        fi
    fi
    wait $runner
    output=$(<"$log")
    rm -f "$log"
}

# Copies what the runner wrote on the device (--save-audio, --spectrogram) to where they
# were asked for here, and points the report at them. $copy_out is the command that
# copies the runner's output folder into the folder it's given.
fetch_output() {
    [[ -n "$audio_dir$spectrogram" ]] || return 0
    local remote=$(print -r -- "$output" | sed -n 's/.*auv3-test output folder: \(.*\)$/\1/p' | tr -d '\r' | tail -1)
    local here=$(mktemp -d -t auv3-test-ios-out)
    if ! "${copy_out[@]}" "$here" >/dev/null 2>&1; then
        print -u2 "auv3-test-ios: couldn't copy the audio or spectrogram back from the device"
        return 0
    fi
    # Some copies keep the folder's name; look inside it if so.
    [[ -d "$here/out" ]] && here="$here/out"
    if [[ -n "$audio_dir" && -d "$here/audio" ]]; then
        mkdir -p "$audio_dir" && cp "$here"/audio/* "$audio_dir"/ 2>/dev/null
        # (The pattern in a variable: a "/" written inside ${…//…/…} would end it.)
        local from="$remote/audio"
        [[ -n "$remote" ]] && output=${output//$from/$audio_dir}
    fi
    if [[ -n "$spectrogram" && -f "$here/spectrogram.png" ]]; then
        cp "$here/spectrogram.png" "$spectrogram"
        local from="$remote/spectrogram.png"
        [[ -n "$remote" ]] && output=${output//$from/$spectrogram}
    fi
}

# A simulator, by name or UDID?
# Exactly: "iPad" mustn't pick the simulator "iPad (A16)".
sim=$(xcrun simctl list devices available | grep -E "^\s+$device \([0-9A-F-]{36}\)|\($device\)" | head -1 | sed -E 's/.*\(([0-9A-F-]{36})\).*/\1/')
if [[ -n "$sim" ]]; then
    print -u2 "… Building the runner for the simulator"
    # A build folder per kind of destination: switching one between them confuses signing.
    xcodebuild -project "$project" -scheme AUv3TestRunner -destination 'generic/platform=iOS Simulator' \
        -derivedDataPath "$build/simulator" PRODUCT_BUNDLE_IDENTIFIER="$bundle" build -quiet >&2 || fail "the runner didn't build"
    app="$build/simulator/Build/Products/Debug-iphonesimulator/AUv3TestRunner.app"
    xcrun simctl boot "$sim" 2>/dev/null
    xcrun simctl bootstatus "$sim" -b >/dev/null || fail "the simulator didn't start"
    xcrun simctl install "$sim" "$app" || fail "couldn't install the runner in the simulator"
    print -u2 "… Testing (a minute or so)"
    capture=(xcrun simctl io "$sim" screenshot)
    launch xcrun simctl launch --console-pty --terminate-running-process "$sim" "$bundle" "$@"
    copy_out_from_simulator() {
        local container=$(xcrun simctl get_app_container "$sim" "$bundle" data) || return 1
        cp -R "$container/Documents/out/." "$1"/
    }
    copy_out=(copy_out_from_simulator)
    fetch_output
else
    # A connected device, by name or identifier.
    udid=$(xcrun devicectl list devices 2>/dev/null | awk -v d="$device" 'NR > 2 && /physical/ && (index($0, d" ") == 1 || index($0, d))' \
        | grep -oE '[0-9A-F]{8}-[0-9A-F]{16}|[0-9A-F-]{36}' | head -1)
    [[ -n "$udid" ]] || fail "no simulator or connected device called \"$device\" (try --devices)"
    [[ -n "${DEVELOPMENT_TEAM:-}" ]] || fail "set DEVELOPMENT_TEAM to your Apple developer team ID, to sign the runner for the device"
    # The runner has the Inter-App Audio entitlement (without it, iOS shows a host on a
    # device only Apple's own Audio Units), so it needs a profile made for its bundle ID.
    # Xcode makes that the first time it runs the runner (README: one-time setup); after
    # that, this finds it. -allowProvisioningUpdates is left out: without an account that
    # xcodebuild can use, it fails even when the profile is there.
    print -u2 "… Building the runner for $device"
    xcodebuild -project "$project" -scheme AUv3TestRunner -destination "id=$udid" \
        -derivedDataPath "$build/device" DEVELOPMENT_TEAM="$DEVELOPMENT_TEAM" PRODUCT_BUNDLE_IDENTIFIER="$bundle" \
        build -quiet >&2 \
        || fail "the runner didn't build or sign for $device. The first time, run it once from Xcode, so Xcode makes its provisioning profile: see \"One-time setup for devices\" in the README"
    app="$build/device/Build/Products/Debug-iphoneos/AUv3TestRunner.app"
    xcrun devicectl device install app --device "$udid" "$app" >/dev/null 2>&1 || fail "couldn't install the runner on $device"
    print -u2 "… Testing on $device (a minute or so; keep it unlocked)"
    capture=(xcrun devicectl device capture screenshot --device "$udid" --destination)
    launch xcrun devicectl device process launch --device "$udid" --console --terminate-existing "$bundle" "$@"
    if [[ "$output" == *"could not be, unlocked"* ]]; then
        fail "$device is locked: unlock it and try again"
    fi
    copy_out=(xcrun devicectl device copy from --device "$udid" --domain-type appDataContainer
              --domain-identifier "$bundle" --source Documents/out --destination)
    fetch_output
fi

# The report sits between the runner's markers; everything else is the system's noise.
report=$(print -r -- "$output" | sed -n '/=== auv3-test report ===/,/=== end of report ===/p' | sed '1d;$d')
[[ -n "$report" ]] || { print -u2 -r -- "$output"; fail "the runner didn't report (output above)"; }
print -r -- "$report"
code=$(print -r -- "$output" | sed -n 's/.*auv3-test exit code: \([0-9]*\).*/\1/p' | tail -1)
exit ${code:-3}
